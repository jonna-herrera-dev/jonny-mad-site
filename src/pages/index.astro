---
/**
 * Home — JONNYMAD
 * Hero + MAD Sessions releases + ecosistema de plataformas
 */
import MainLayout from "../layouts/MainLayout.astro";
import Container from "../components/ui/Container.astro";
import PlatformLinks from "../components/madsession/PlatformLinks.astro";
import { streamingLinksChaCunCha } from "../data/streamingLinks";
import "../styles/madsession.css";
import styles from "./index.module.css";
---

<MainLayout
	title="JONNYMAD | Madhouse Riddim Lab"
	description="Sitio oficial de JONNYMAD — MAD Sessions, Cyber Pop underground y Madhouse Riddim Lab."
	lang="es"
>
	<div class={styles.page}>
		<section class={styles.hero} aria-labelledby="home-brand">
			<h1 id="home-brand" class={styles.brand}>TOO RUDE TO FOLLOW. <br> TOO MAD TO STOP.</h1>
			<p class={styles.tagline}>
				Desde las raíces jamaicanas hasta las calles de Bogotá, JonnyMad mezcla sonidos, épocas y culturas con espíritu rebelde y actitud rude boy.


			</p>
			<figure class={styles.figure}>
				<div class={styles.frame}>
					<div class={styles.photo}>
						<img
							src="/assets/images/hero-home.webp"
							alt="JONNYMAD"
							width="790"
							height="730"
							loading="eager"
						/>
						<div class={styles.overlay} aria-hidden="true"></div>
					</div>
				</div>
			</figure>
		</section>

		<section class={styles.section} id="releases" aria-labelledby="releases-title">
			<Container class={styles.sectionInner}>
				<header class={styles.sectionHead}>
					<div>
						<span class={styles.eyebrow}>◎ Catalog showcase</span>
						<h2 id="releases-title" class={styles.sectionTitle}>MAD Sessions Releases</h2>
					</div>
					<p class={styles.sectionLead}>
						No son simples covers. Son encuentros, reinterpretaciones y nuevas formas de entender canciones que nos gustan.
					</p>
				</header>

				<div class={styles.releaseGrid}>
					<article class={styles.releaseCard}>
						<div class={styles.cover}>
							<img
								src="/assets/images/portada.webp"
								alt="Portada MAD SESSIONS #1 — A Ritmo Cha Cun Cha"
								width="3000"
								height="3000"
								loading="lazy"
							/>
						</div>
						<div>
							<h3 class={styles.releaseTitle}>MAD Sessions #1</h3>
							<p class={styles.releaseTrack}>A Ritmo Cha Cun Cha feat. Subcantante</p>
							<p class={styles.releaseCopy}>
								Una dosis de sabor, ritmo y espíritu caribeño en la capital. Una nueva
								versión, una descarga de actitud y el primer golpe de esta serie.
							</p>
						</div>
						<div class={styles.releaseActions}>
							<a class={styles.releaseBtn} href="/madsessions/a-ritmo-cha-cun-cha">
								Escuchar MAD Sessions #1
							</a>
						</div>
					</article>

					<article class={`${styles.releaseCard} ${styles.releaseCardAlt}`}>
						<div class={styles.cover}>
							<img
								src="/assets/images/portada-gangsters-modernos.webp"
								alt="Portada MAD SESSIONS #2 — Gangsters Modernos"
								width="1024"
								height="1024"
								loading="lazy"
							/>
						</div>
						<div>
							<h3 class={styles.releaseTitle}>MAD Sessions #2</h3>
							<p class={`${styles.releaseTrack} ${styles.releaseTrackAlt}`}>
								Gangsters Modernos feat. Santi Luna
							</p>
							<p class={styles.releaseCopy}>
								Un guiño a la vieja escuela y una descarga de espíritu 2Tone. Un homenaje
								a Los Intocables, hecho desde nuestra propia esquina.
							</p>
						</div>
						<div class={styles.releaseActions}>
							<a
								class={`${styles.releaseBtn} ${styles.releaseBtnAlt}`}
								href="/madsessions/gangsters-modernos"
							>
								Escuchar MAD Sessions #2
							</a>
						</div>
					</article>
				</div>
			</Container>
		</section>

		<section class={styles.section} id="platforms" aria-labelledby="platforms-title">
			<Container class={styles.sectionInner}>
				<header class={styles.sectionHead}>
					<div>
						<span class={styles.eyebrow}>Ecosistema digital</span>
						<h2 id="platforms-title" class={styles.sectionTitle}>
							TAKE THE MADNESS EVERYWHERE
						</h2>
					</div>
					<p class={styles.sectionLead}>
						Nuestra música está donde tú estás. Encuentra a JonnyMad, escucha los lanzamientos y lleva estos ritmos contigo.
					</p>
				</header>

				<div class="madSessionTokens">
					<PlatformLinks links={streamingLinksChaCunCha} showTitle={false} />
				</div>
			</Container>
		</section>
	</div>
</MainLayout>
