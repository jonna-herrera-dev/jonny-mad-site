---
import Container from "../ui/Container.astro";
import styles from "./Header.module.css";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const madSessionsHref = "/#releases";
const isMadSession = pathname.startsWith("/madsessions");
const isHome = pathname === "/";
---

<header class={styles.bar}>
	<Container class={styles.inner}>
		<div class={styles.row}>
			<a href="/" class={styles.logo} aria-current={isHome ? "page" : undefined}>JONNYMAD</a>
			<nav class={styles.nav} aria-label="Principal">
				<a
					href={madSessionsHref}
					class={styles.link}
					aria-current={isMadSession ? "page" : undefined}
				>
					MAD SESSIONS
				</a>
			</nav>
		</div>
	</Container>
</header>
